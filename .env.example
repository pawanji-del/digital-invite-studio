# =============================================================================
# INTERACTIVE DIGITAL INVITATION STUDIO - ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. Admin Dashboard PIN (Used to authenticate at /admin/login)
ADMIN_PIN=7788

# 2. Public Application URL (Update this on Vercel to your live domain e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. MongoDB Atlas Free Database Connection String (Optional for local dev, Recommended for Vercel)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/invitation_studio?retryWrites=true&w=majority
# If left blank, the studio automatically falls back to local JSON storage!
MONGODB_URI=
